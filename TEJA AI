
<!DOCTYPE html>
<html lang="en">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TEJA AI</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #080b18;
  color: white;
}
header {
  padding: 22px;
  text-align: center;
  background: #11152c;
  border-bottom: 2px solid #7545ff;
}
header h1 { color: #a98aff; margin: 0; }
header p { color: #aaa; }
#chat {
  height: 65vh;
  overflow-y: auto;
  padding: 15px;
}
.msg {
  padding: 12px;
  margin: 10px 0;
  border-radius: 12px;
  max-width: 85%;
  line-height: 1.5;
}
.bot { background: #202644; }
.user {
  background: #633dce;
  margin-left: auto;
}
.controls {
  position: fixed;
  bottom: 0;
  width: 100%;
  padding: 14px;
  background: #11152c;
  display: flex;
  gap: 8px;
}
input {
  min-width: 0;
  flex: 1;
  padding: 13px;
  border-radius: 10px;
  border: 1px solid #555;
  background: #080b18;
  color: white;
}
button {
  border: 0;
  padding: 12px;
  border-radius: 10px;
  background: #8153ed;
  color: white;
  font-weight: bold;
}
</style>
</head>
<body>

<header>
  <h1>🎮 TEJA AI</h1>
  <p>Your Personal Gaming Assistant</p>
</header>

<div id="chat">
  <div class="msg bot">
    Welcome to TEJA AI! 🔥<br>
    Ask me anything about gaming.
  </div>
</div>

<div class="controls">
  <input id="question"
    placeholder="Ask your gaming question...">
  <button onclick="send()">Send</button>
  <button onclick="voice()">🎤</button>
</div>

<script>
const chat = document.getElementById("chat");

function addMessage(message, type) {
  const div = document.createElement("div");
  div.className = "msg " + type;
  div.textContent = message;
  chat.appendChild(div);
  chat.scrollTop = chat.scrollHeight;
}

function gamingAnswer(question) {
  const q = question.toLowerCase();

  if (q.includes("free fire"))
    return "Free Fire tip: Practice movement, aim and teamwork. Play fair and improve your skills!";

  if (q.includes("sensitivity"))
    return "Sensitivity depends on your device and comfort. Try different settings in training mode.";

  if (q.includes("youtube"))
    return "Create interesting gameplay videos, use clear thumbnails and make engaging titles!";

  if (q.includes("instagram"))
    return "Post original gaming clips, create engaging reels and interact with your audience!";

  if (q.includes("hello") || q.includes("hi"))
    return "Hello gamer! Welcome to TEJA AI. What game are we talking about today?";

  return "Great question! I'm your TEJA AI demo assistant. More AI features are coming soon!";
}

function send() {
  const input = document.getElementById("question");
  const q = input.value.trim();

  if (!q) return;

  addMessage(q, "user");
  input.value = "";

  setTimeout(() => {
    addMessage(gamingAnswer(q), "bot");
  }, 400);
}

document.getElementById("question")
.addEventListener("keydown", e => {
  if (e.key === "Enter") send();
});

function voice() {
  const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    addMessage("Voice input is not supported in this browser.", "bot");
    return;
  }

  const recognition = new SpeechRecognition();
  recognition.lang = "en-US";
  recognition.onresult = event => {
    document.getElementById("question").value =
      event.results[0][0].transcript;
    send();
  };
  recognition.start();
}
</script>

</body>
</html>
